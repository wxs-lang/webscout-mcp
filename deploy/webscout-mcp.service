[Unit]
Description=WebScout MCP Server - Web search and fetch tools for AI agents
Documentation=https://github.com/wxs-lang/webscout-mcp
After=network.target

[Service]
Type=simple
User=webscout
Group=webscout
WorkingDirectory=/opt/webscout-mcp
Environment="WEBSCOUT_LOG_LEVEL=INFO"
Environment="WEBSCOUT_CACHE_DIR=/var/cache/webscout"
ExecStart=/usr/bin/python3 -m webscout_mcp --transport stdio
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webscout-mcp

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/webscout
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
