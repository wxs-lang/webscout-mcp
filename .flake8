[flake8]
# Flake8 configuration for webscout-mcp
max-line-length = 120
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    venv,
    venv311,
    .venv,
    docs,
    examples,
    tests,
    *.egg-info
per-file-ignores =
    __init__.py:F401
    tests/*:E501,F401,F811
    examples/*:E501,F401,F811
    scripts/*:E501,F401,F811
